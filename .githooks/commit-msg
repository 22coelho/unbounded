#!/usr/bin/env bash
# commit-msg hook -- enforces the guardian commit rules.
#
#   subject : imperative, capitalized, no type prefix, no trailing period,
#             maximum 50 characters
#   message : no AI attribution of any kind
#
# Bypass only in a genuine emergency: COMMIT_MSG_SKIP=1 git commit ...
# Prefer fixing the message. Never use --no-verify.

set -eu

if [ "${COMMIT_MSG_SKIP:-0}" = "1" ]; then
  exit 0
fi

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  echo "commit-msg: no message file supplied" >&2
  exit 1
fi

MAX_SUBJECT=50

fail() {
  printf 'commit-msg: %s\n' "$1" >&2
  shift
  for line in "$@"; do
    printf '  %s\n' "$line" >&2
  done
  printf '\nRules: imperative subject, capitalized, no type prefix,\n' >&2
  printf 'no trailing period, %s chars maximum, no AI attribution.\n' "$MAX_SUBJECT" >&2
  printf 'See .opencode/agents/guardian.md\n' >&2
  exit 1
}

# Drop comment lines and blank lines to get the real message.
message="$(sed -e '/^#/d' -e '/^[[:space:]]*$/d' "$msg_file")"

if [ -z "$message" ]; then
  fail "empty commit message"
fi

subject="$(printf '%s\n' "$message" | head -n 1)"
# Trim trailing whitespace from the subject.
subject="$(printf '%s' "$subject" | sed -e 's/[[:space:]]*$//')"

# Merge, revert, and autosquash commits are generated by git itself.
case "$subject" in
  "Merge "*|'Revert '*|"fixup! "*|"squash! "*) exit 0 ;;
esac

# --- subject length ---------------------------------------------------------
length=${#subject}
if [ "$length" -gt "$MAX_SUBJECT" ]; then
  fail "subject is $length characters (max $MAX_SUBJECT)" \
    "    $subject" \
    "Split the commit rather than shrinking the words."
fi

# --- trailing period --------------------------------------------------------
case "$subject" in
  *.) fail "subject ends with a period" "    $subject" ;;
esac

# --- conventional-commit prefix --------------------------------------------
prefix_re='^(feat|fix|chore|refactor|docs|doc|test|tests|perf|build|ci|style|revert)(\([^)]*\))?!?:'
if printf '%s' "$subject" | grep -Eqi "$prefix_re"; then
  fail "subject starts with a type prefix" \
    "    $subject" \
    "Drop the prefix and write a plain imperative sentence."
fi

# --- capitalization ---------------------------------------------------------
first="${subject%"${subject#?}"}"
case "$first" in
  [a-z]) fail "subject starts lowercase" "    $subject" "Capitalize the first word." ;;
esac

# --- AI attribution ---------------------------------------------------------
lowered="$(printf '%s\n' "$message" | tr '[:upper:]' '[:lower:]')"

ai_re='(generated (with|by)|assisted-by:|co-authored-by:.*(claude|anthropic|openai|gpt|copilot|gemini|llm|opencode|assistant|agent|ai[^a-z]))'

if printf '%s' "$lowered" | grep -Eq "$ai_re"; then
  fail "message attributes the commit to AI tooling" \
    "Remove the trailer, footer, or attribution line." \
    "Write as the human author of the change."
fi

if printf '%s' "$message" | grep -q '🤖'; then
  fail "message contains a robot emoji" "Remove it."
fi

exit 0
